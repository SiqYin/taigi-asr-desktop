{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taigi ASR",
  "version": "1.0.0",
  "identifier": "ai.taigi.asrdesktop",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "台語語音轉錄 Taigi ASR",
        "width": 1120,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:*; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "TraditionalChinese"]
      }
    }
  }
}
