{
  "name": "taigi-asr-desktop",
  "version": "1.1.0",
  "description": "台語語音自動轉錄桌面客戶端 — Breeze-ASR-26 (Tauri 2 + Python sidecar)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "web:serve": "node tools/serve-web.mjs",
    "web:e2e": "node tools/e2e-web.mjs",
    "web:e2e:prod": "node tools/e2e-production.mjs",
    "web:wasm": "bash web/wasm-src/build-wasm.sh",
    "web:verify": "python tools/verify-subtitle-parity.py",
    "web:verify:wasm": "node tools/verify-wasm-browser.mjs",
    "android:stage": "bash scripts/stage-android-assets.sh",
    "clean": "bash scripts/clean-local-artifacts.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
